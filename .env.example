# Copia este fichero como .env (desarrollo) o .env.production (build) y rellena los valores.
# Vite incrusta las variables VITE_* en el build: hay que volver a compilar si cambian.

# URL base del «Especialista en Safety» (index.html estático, ver APPS/Especialista-Safety-Servidor/LEEME-DESPLIEGUE.md).
# La pestaña Resumen de cada proyecto añade al final el ancla de su familia (#eps, #loading, #escaleras, #pva, #redes,
# #geotrench, #alsipercha, #tornapuntas). Vacía: el Resumen muestra «sección #… (enlace no configurado)».
# Ejemplo: VITE_ESPECIALISTA_URL=https://<servidor>/safety/
VITE_ESPECIALISTA_URL=

# Opcionales (como el resto de subapps del portal):
# PORTAL_BASE_URL=http://localhost:5173
# APPHUB_RETURN_URL=
